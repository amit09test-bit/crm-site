{
  "manifest_version": 3,
  "name": "TaskFlow Learning Extensions",
  "version": "1.0.0",
  "description": "Full Page Screenshot (PNG/PDF) and Highlighted Text Wikipedia Search",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "TaskFlow Learning Extensions",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "downloads",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
